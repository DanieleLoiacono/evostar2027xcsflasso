{
  "campaign_id": "evostar2027-v2",
  "description": "Controlled comparison of xcsf_python-2.0.0 and xcslib-1.5-rc1-niches on continuous 1-D function approximation (single-step, supervised), plus a Python-only Lasso extension.",

  "n_runs": 30,
  "seed_base": 1000,
  "epsilon_fraction": 0.05,

  "benchmarks": ["sine_low_1d", "sine_shifted_1d", "sinus3_1d", "sinus4_1d", "abs_mix_1d"],

  "xcsf": {
    "population_size": 800,
    "n_learning_problems": 50000,
    "beta": 0.2,
    "alpha": 0.1,
    "nu": 5.0,
    "theta_ga": 25,
    "crossover_probability": 0.8,
    "mutation_probability": 0.04,
    "r0_fraction": 0.2,
    "m0_fraction": 0.2,
    "mutation": "fixed",
    "crossover": "one_point",
    "selection": "roulette",
    "theta_delete": 20,
    "delta": 0.1,
    "theta_subsume": 20,
    "ga_subsumption": true,
    "as_subsumption": false,
    "initial_fitness": 0.01,
    "initial_error": 0.0,
    "initial_set_size": 1.0,
    "use_mam": true,
    "error_before_prediction": true,
    "bounded": false,
    "condensation": false
  },

  "benchmark_overrides": {},

  "predictors": {
    "constant":     {"type": "constant", "eta": 0.2},
    "nlms":         {"type": "nlms", "eta": 0.2, "x0": 1.0},
    "rls":          {"type": "rls_xcslib", "x0": 1.0},
    "rls_delta":    {"type": "rls_delta", "x0": 1.0, "delta": 1000.0},
    "rls_standard": {"type": "rls_standard", "x0": 1.0, "delta": 1000.0},
    "lasso_online": {"type": "lasso_online", "eta": 0.2, "x0": 1.0, "lasso_alpha": [0.001, 0.01, 0.1], "learning_rate_decay": 0.0},
    "lasso_batch":  {"type": "lasso_batch", "x0": 1.0, "lasso_alpha": [0.001, 0.01, 0.1], "window": 256, "max_iter": 1000, "tol": 1e-6}
  },

  "studies": {
    "parity": {
      "description": "Python vs C++ under semantically identical XCSF and predictor settings (raw inputs, as xcslib has no input scaling).",
      "implementations": ["cxx", "py"],
      "predictors": ["constant", "nlms", "rls", "rls_delta"],
      "input_representation": "raw"
    },
    "pyext": {
      "description": "Python-only extension: Lasso Batch / Lasso Online vs common predictors, all on domain-scaled inputs z=(x-min)/(max-min). Never pooled with the parity study. sine_shifted_1d is omitted: after domain scaling it is identical to sine_low_1d.",
      "implementations": ["py"],
      "benchmarks": ["sine_low_1d", "sinus3_1d", "sinus4_1d", "abs_mix_1d"],
      "predictors": ["constant", "nlms", "rls", "rls_standard", "lasso_online", "lasso_batch"],
      "input_representation": "unit"
    }
  },

  "monitoring": {
    "window": 100,
    "py_grid_checkpoints": 10,
    "py_unmatched": "nearest"
  },

  "analysis": {
    "alpha": 0.05,
    "n_bootstrap": 10000,
    "last_fraction": 0.1,
    "convergence_consecutive_windows": 5,
    "equivalence_margin_error_eps_fraction": 0.1,
    "equivalence_margin_size_relative": 0.1,
    "equivalence_margin_fraction_abs": 0.05,
    "bootstrap_seed": 12345
  },

  "profiles": {
    "smoke": {
      "campaign_id_suffix": "-smoke",
      "n_runs": 2,
      "benchmarks": ["sine_low_1d", "sine_shifted_1d"],
      "xcsf": {"population_size": 200, "n_learning_problems": 3000},
      "predictors": {"lasso_online": {"lasso_alpha": [0.01]}, "lasso_batch": {"lasso_alpha": [0.01]}}
    },
    "pilot": {
      "campaign_id_suffix": "-pilot",
      "n_runs": 5
    }
  }
}
